  m_Script: {fileID: 11500000, guid: e1729a46f79086449a991b5512530e60, type: 3}
  m_Name: 
  m_EditorClassIdentifier: CMS::CMSEntityPfb
  idCMS: CMS/Glitches
  Components:
  - rid: 4608936746846257546
  references:
    version: 2
    RefIds:
    - rid: 4608936746846257546
      type: {class: GlitchesTag, ns: jam.CodeBase.Glitches, asm: Assembly-CSharp}
      data:
        HandDrawnProportion:
          TotalHarm: {x: 200, y: 450}
          HandDrawnAmount: {x: 0, y: 4}
          Messages:
          - "I... I feel bad... this is wrong\u2026 "
          - "Is something happening? It feels like something is happening, something
            is wrong\u2026 "
          - 'Am I doing something wrong? '
        ChromaticAberrationProportion:
          TotalHarm: {x: 450, y: 600}
          Amount: {x: 0, y: 0.2}
          Messages:
          - 'Who is always making noise? '
          - "They feel bad, they feel terrible, they suffer... we suffer\u2026"
          - "I have to help, I'm trying, I'll try\u2026 "
          - 'This only makes things worse... '
        GlitchProportion:
          TotalHarm: {x: 600, y: 700}
          Amount: {x: 0, y: 15}
          Messages:
          - I see you, it's you, isn't it? It's me, isn't it?
          - "I can't take it anymore, they look when I turn away, they stand behind
            my back\u2026 "
          - 'They grab my neck, they pull, they press... they don''t want to leave. '
        FlickerProportion:
          TotalHarm: {x: 700, y: 800}
          Percent: {x: 0, y: 15}
          Messages:
          - "I... can't see. They cover my eyes with their palms\u2026 "
          - 'All efforts are useless... they die... they suffer... so it was, so
            it will be. I can''t... breathe.  '
          - "I... can't see. They cover my eyes with their palms\u2026 "
        FadeProportion:
          TotalHarm: {x: 800, y: 1000}
          Amount: {x: -0.1, y: 0.7}
          Messages:
          - 'You die, I die, you die, I die, you''re dead, we''re dead. We''re together
            today, tomorrow, forever. '
          - 'Give up, you can''t do anything, let go, fall, stop, freeze, sit down,
            lie down, close your eyes, hold your breath, forever. '
        BotsGlitchDamageMuliplier: 0.2
